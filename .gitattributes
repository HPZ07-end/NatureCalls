# Normalize shared text on macOS and Windows. Unity YAML stays reviewable.
* text=auto
*.cs text eol=lf
*.asmdef text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf whitespace=-blank-at-eol
*.shader text eol=lf
*.txt text eol=lf
*.pdf binary
# No binary art exists yet. Add targeted LFS patterns when assets are added.
# Do not put .unity, .prefab, .asset or .meta in LFS indiscriminately.
