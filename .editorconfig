root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,asmdef,yml,yaml}]
indent_size = 2

# Preserve Unity's generated serialization, including empty fields.
[*.{unity,prefab,asset,meta,mat}]
trim_trailing_whitespace = false
